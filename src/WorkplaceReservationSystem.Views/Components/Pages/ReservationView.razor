<div class="reservation-grid">
    
    <label class="reservation-label">Datum:</label>
    <input type="date" class="reservation-input" @bind-value="DataContext.MainViewModel.ReservationDraft.Date" @onblur="OnReservationDraftChanged" />

    <label class="reservation-label">Von:</label>
    <input type="time" class="reservation-input" @bind-value="DataContext.MainViewModel.ReservationDraft.StartTime" @onblur="OnReservationDraftChanged" />

    <label class="reservation-label">Bis:</label>
    <input type="time" class="reservation-input" @bind-value="DataContext.MainViewModel.ReservationDraft.EndTime" @onblur="OnReservationDraftChanged" />

    <label>@DataContext.ValidationResult.ErrorMessage</label>

    <button class="reservation-button" @onclick="DataContext.TryCreateReservationCommand.Execute" disabled="@(!DataContext.TryCreateReservationCommand.CanExecute(null))">
        Reservieren
    </button>
</div>


