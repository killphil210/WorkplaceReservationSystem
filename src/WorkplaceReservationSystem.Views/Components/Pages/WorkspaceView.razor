@using WorkplaceReservationSystem.Domain
@using WorkplaceReservationSystem.Views.Components

<div class="workspace-grid">
    <label>@DataContext.WorkspaceService.GetWorkspace().Name</label>
    <div></div>

    @foreach (Workplace workplace in DataContext.WorkspaceService.GetWorkspace().Workplaces)
    {
        <Desk Workplace="@workplace" IsSelected="@(workplace.Id == DataContext.MainViewModel.SelectedWorkplaceId)" IsAvailable="@DataContext.MainViewModel.AvailableWorkplaces.Contains(workplace.Id)" OnClick="OnDeskClicked" />
    }
</div>


