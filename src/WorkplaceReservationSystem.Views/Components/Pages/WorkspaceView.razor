@using WorkplaceReservationSystem.Domain
@using WorkplaceReservationSystem.Views.Components

<div class="workspace-grid">
    <label>Stillarbeitsraum</label>
    <div></div>

    @foreach (Workplace workplace in DataContext.WorkspaceService.GetWorkplaces())
    {
        <Desk Workplace="@workplace"                    
         IsSelected="@(workplace.Id == DataContext.MainViewModel.ReservationDraft.WorkplaceId)" 
         IsAvailable="@DataContext.MainViewModel.AvailableWorkplaces.Contains(workplace.Id)" 
         WorkplaceReservationDTO="@DataContext.GetWorkplaceReservation(DataContext.MainViewModel.ReservationDraft, workplace.Id)"
         OnClick="OnDeskClicked" 
         />
    }
</div>






